# Supabase — requeridas en build-time (VITE_ prefix → se embeben en el bundle)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# Barcode Lookup API — https://www.barcodelookup.com
VITE_BARCODE_LOOKUP_API_KEY=<your-api-key>

# IA — OpenRouter (https://openrouter.ai/keys)
# Modelo usado por el agente WhatsApp
OPENROUTER_API_KEY=sk-or-v1-...

# OCR de facturas — Google Gemini
GEMINI_API_KEY=<your-gemini-api-key>

# Edge Functions / integraciones
RAPPI_WEBHOOK_SECRET=<shared-secret>
ALLOW_UNSIGNED_RAPPI_WEBHOOKS=false
RAPPI_IP_ALLOWLIST=<comma-separated-ip-list>
EVOLUTION_WEBHOOK_SECRET=<shared-secret>
EVOLUTION_IP_ALLOWLIST=<comma-separated-ip-list>
EVOLUTION_API_URL=https://<evolution-host>
EVOLUTION_API_KEY=<evolution-api-key>
