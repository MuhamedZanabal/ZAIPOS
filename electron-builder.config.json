{
  "appId": "com.zaipos.pos",
  "productName": "ZAIPOS",
  "copyright": "Copyright © 2026 ZAIPOS Contributors",
  "asar": true,

  "directories": {
    "output": "release",
    "buildResources": "public"
  },

  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "generateUpdatesFilesForAllChannels": true,
  "publish": {
    "provider": "github",
    "owner": "MuhamedZanabal",
    "repo": "ZAIPOS",
    "releaseType": "release"
  },

  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],

  "extraResources": [],

  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb",      "arch": ["x64"] }
    ],
    "category": "Office",
    "icon": "public/icon-source.svg",
    "maintainer": "ZAIPOS Contributors",
    "vendor": "ZAIPOS"
  },

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "public/favicon.ico"
  },

  "mac": {
    "target": ["dmg"],
    "icon": "public/icon-source.svg",
    "category": "public.app-category.finance"
  },

  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZAIPOS"
  }
}
