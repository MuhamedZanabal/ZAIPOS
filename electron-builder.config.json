{
  "appId": "com.zaipos.pos",
  "productName": "ZAIPOS",
  "copyright": "Copyright © 2026 ZAIPOS Contributors",
  "asar": true,

  "directories": {
    "output": "release",
    "buildResources": "public"
  },

  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],

  "extraResources": [],

  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb",      "arch": ["x64"] }
    ],
    "category": "Office",
    "icon": "public/icon.png",
    "maintainer": "ZAIPOS Contributors",
    "vendor": "ZAIPOS"
  },

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "public/icon.ico",
    "signAndEditExecutable": false
  },

  "mac": {
    "target": ["dmg"],
    "icon": "public/icon.icns",
    "category": "public.app-category.finance"
  },

  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZAIPOS"
  }
}
