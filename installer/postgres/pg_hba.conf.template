# ZAIPOS PostgreSQL is loopback-only. Both login roles are held exclusively by the local service.
hostssl postgres zaipos_owner_bootstrap 127.0.0.1/32 scram-sha-256
hostssl zaipos zaipos_owner_bootstrap 127.0.0.1/32 scram-sha-256
hostssl zaipos zaipos_service 127.0.0.1/32 scram-sha-256
hostssl postgres zaipos_owner_bootstrap ::1/128 scram-sha-256
hostssl zaipos zaipos_owner_bootstrap ::1/128 scram-sha-256
hostssl zaipos zaipos_service ::1/128 scram-sha-256
